library(astsa)
# Simulate ARIMA(0,0,2) = MA(2)
set.seed(123)  # for reproducibility
ma2_sim <- arima.sim(list(order = c(0, 0, 2), ma = c(0.7, 0.4)), n = 200)
# Plot the time series
plot.ts(ma2_sim, main = "Simulated ARIMA(0,0,2) — MA(2) Process",
ylab = "Value", xlab = "Time")
# Correlogram (ACF and PACF together)
acf2(ma2_sim, main = "ACF and PACF — MA(2)")
