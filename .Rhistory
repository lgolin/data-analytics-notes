library(astsa)
library(forecast)
library(tseries)
# Load and check format
data(cardox)
class(cardox)  # should be "ts"
head(cardox)
# 1. Plot the time series
autoplot(cardox, main = "Monthly CO2 - Mauna Loa",
ylab = "CO2 (ppm)")
# 2. Decompose
autoplot(decompose(cardox))
# 3. Stationarity tests
adf.test(cardox)   # H0: non-stationary
kpss.test(cardox)  # H0: stationary
# 4. Transformations
# Log (stabilise variance)
log_cardox <- log(cardox)
# Diff (remove trend)
d_log_cardox <- diff(log_cardox)
# Seasonal diff (remove seasonality, lag=12)
d12_log_cardox <- diff(d_log_cardox, lag = 12)
autoplot(d12_log_cardox, main = "Transformed CO2")
acf2(d12_log_cardox)
# Stationarity check after transformation
adf.test(d12_log_cardox)
kpss.test(d12_log_cardox)
# 5. auto.arima + forecast
fit <- auto.arima(log_cardox)
fit
checkresiduals(fit)
# Forecast 24 months ahead
fore <- forecast(fit, h = 24)
fore$mean <- exp(fore$mean)
fore$lower <- exp(fore$lower)
fore$upper <- exp(fore$upper)
fore$x <- exp(fore$x)
plot(fore, main = "CO2 Forecast - 24 months")
# CLASSICAL METHODS
# cardox has trend + seasonality --> Holt-Winters
# Part 4: Both additive and multiplicative
fit_add  <- hw(cardox, seasonal = "additive",      h = 2*12)
fit_mult <- hw(cardox, seasonal = "multiplicative", h = 2*12)
# GOF measures
accuracy(fit_add)
accuracy(fit_mult)
# Part 5: Forecast plots
plot(fit_add,  main = "Holt-Winters Additive Forecast")
plot(fit_mult, main = "Holt-Winters Multiplicative Forecast")
library(astsa)
data(cardox)
class(cardox)
start(cardox)
end(cardox)
frequency(cardox)
plot(cardox,
main = "Monthly CO2 at Mauna Loa",
ylab = "CO2 (ppm)",
xlab = "Time")
decomp_add <- decompose(cardox, type = "additive")
plot(decomp_add)
decomp_mult <- decompose(cardox, type = "multiplicative")
plot(decomp_mult)
sd(na.omit(decomp_add$random))
sd(na.omit(decomp_mult$random))
fit_add <- hw(cardox, seasonal = "additive", h = 24)
fit_mult <- hw(cardox, seasonal = "multiplicative", h = 24)
accuracy(fit_add)
accuracy(fit_mult)
fit_add <- hw(cardox, seasonal = "additive", h = 24)
fit_mult <- hw(cardox, seasonal = "multiplicative", h = 24)
plot(fit_add, main = "Holt-Winters Additive Forecast")
plot(fit_mult, main = "Holt-Winters Multiplicative Forecast")
accuracy(fit_add)
accuracy(fit_mult)
# 2 * 12 = 24
best_forecast <- hw(cardox, seasonal = "additive", h = 24)
plot(best_forecast,
main = "CO2 Forecast - Holt-Winters Additive",
ylab = "CO2",
xlab = "Time")
best_forecast
plot(cardox,
main = "Monthly CO2 at Mauna Loa",
ylab = "CO2 (ppm)",
xlab = "Time")
acf2(cardox)
adf.test(cardox, alternative = "stationary")
kpss.test(cardox)
plot(cardox,
main = "Monthly CO2 at Mauna Loa",
ylab = "CO2 (ppm)",
xlab = "Time")
acf2(cardox)
adf.test(cardox, alternative = "stationary")
kpss.test(cardox)
plot(cardox,
main = "Monthly CO2 at Mauna Loa",
ylab = "CO2",
xlab = "Time")
acf2(cardox)
adf.test(cardox, alternative = "stationary")
kpss.test(cardox)
log_cardox <- log(cardox)
plot(log_cardox, main = "Log CO2 Series")
d_log_cardox <- diff(log_cardox)
plot(d_log_cardox, main = "First Difference of Log CO2")
d12_log_cardox <- diff(d_log_cardox, lag = 12)
plot(d12_log_cardox, main = "First and Seasonal Difference")
acf2(d12_log_cardox)
adf.test(d12_log_cardox, alternative = "stationary")
kpss.test(d12_log_cardox)
fit_auto <- auto.arima(log_cardox, seasonal = TRUE)
fit_auto
summary(fit_auto)
checkresiduals(fit_auto)
fore <- forecast(fit_auto, h = 24)
plot(fore,
main = "CO2 Forecast - 24 Months",
ylab = "CO2 (ppm)",
xlab = "Time")
